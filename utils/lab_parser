        }
        
        return module_mapping.get(lab_info.lab_type, ['all'])


class GenericLabParser:
    """
    Generic parser for non-PortSwigger labs (HTB, VulnHub, etc.)
    """
    
    def parse(self, url: str) -> Optional[LabInfo]:
        """
        Basic parsing for generic targets
        """
        parsed = urlparse(url)
        
        if not parsed.netloc:
            return None
        
        return LabInfo(
            lab_id=parsed.netloc.replace('.', '_'),
            lab_type='generic',
            category='Unknown',
            difficulty='unknown',
            base_url=url,
            is_portswigger=False,
            raw_url=url
        )


class LabParser:
    """
    Unified lab parser that handles both PortSwigger and generic targets
    """
    
    def __init__(self):
        self.portswigger_parser = PortSwiggerLabParser()
        self.generic_parser = GenericLabParser()
    
    def parse(self, url: str, html_content: Optional[str] = None) -> Optional[LabInfo]:
        """
        Parse any lab URL and return structured information
        """
        # Try PortSwigger first
        if self.portswigger_parser.is_portswigger_url(url):
            return self.portswigger_parser.parse(url, html_content)
        
        # Fall back to generic parser
        return self.generic_parser.parse(url)
    
    def is_portswigger(self, url: str) -> bool:
        """Check if URL is a PortSwigger lab"""
        return self.portswigger_parser.is_portswigger_url(url)


# Convenience functions
def parse_lab_url(url: str) -> Optional[LabInfo]:
    """Quick function to parse a lab URL"""
    parser = LabParser()
    return parser.parse(url)


