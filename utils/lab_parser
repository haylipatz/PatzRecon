#!/usr/bin/env python3
"""
PortSwigger Lab URL Parser
Extracts lab IDs and identifies lab types from PortSwigger URLs
"""

import re
from urllib.parse import urlparse
from typing import Dict, Optional, List
from dataclasses import dataclass


@dataclass
class LabInfo:
    """Structured lab information"""
    lab_id: str
    lab_type: str
    category: str
    difficulty: str
    base_url: str
    is_portswigger: bool
    raw_url: str


