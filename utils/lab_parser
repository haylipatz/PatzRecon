    def __init__(self):
        self.compiled_patterns = self._compile_patterns()
    
    def _compile_patterns(self) -> Dict:
        """Compile regex patterns for matching"""
        compiled = {}
        for lab_type, config in self.LAB_PATTERNS.items():
            compiled[lab_type] = {
                'regex': [re.compile(p, re.IGNORECASE) for p in config['patterns']],
                'category': config['category'],
                'topics': config['topics']
            }
        return compiled
    
    def is_portswigger_url(self, url: str) -> bool:
        """Check if URL belongs to PortSwigger labs"""
        parsed = urlparse(url)
        domain = parsed.netloc.lower()
        
        return any(
            domain.endswith(d) or d in domain 
            for d in self.PORTSWIGGER_DOMAINS
        )
    
    def extract_lab_id(self, url: str) -> Optional[str]:
        """
        Extract lab ID from PortSwigger URL
        Example: https://0a7b0010.web-security-academy.net -> 0a7b0010
        """
        parsed = urlparse(url)
        domain = parsed.netloc.lower()
        
        # Pattern: [alphanumeric].web-security-academy.net
        match = re.match(r'^([a-f0-9]+)\.web-security-academy\.net$', domain)
        if match:
            return match.group(1)
        
        # Pattern: lab-[id].portswigger-labs.net
        match = re.match(r'^lab-([a-f0-9]+)\.', domain)
        if match:
            return match.group(1)
        
        # Pattern: academy-[id].portswigger.net
        match = re.match(r'^academy-([a-f0-9]+)\.', domain)
        if match:
            return match.group(1)
        
        # Check path for lab ID
        path_match = re.search(r'/lab/([a-f0-9]+)', parsed.path)
        if path_match:
            return path_match.group(1)
        
        return None
    
    def detect_lab_type(self, url: str, html_content: Optional[str] = None) -> str:
        """
        Detect lab type from URL patterns and optional HTML content
        """
        url_lower = url.lower()
        
        # Check URL patterns
        for lab_type, config in self.compiled_patterns.items():
            for pattern in config['regex']:
                if pattern.search(url_lower):
                    return lab_type
        
        # Check HTML content if provided
        if html_content:
            html_lower = html_lower = html_content.lower()
            for lab_type, config in self.compiled_patterns.items():
                for topic in config['topics']:
                    if topic.lower() in html_lower:
                        return lab_type
        
        return 'unknown'
    
    def get_lab_difficulty(self, url: str) -> str:
        """
        Estimate lab difficulty based on URL patterns
        """
        # Practitioners labs are harder than apprentices
        if 'practitioner' in url.lower():
            return 'practitioner'
        elif 'expert' in url.lower():
            return 'expert'
        return 'apprentice'
    
    def parse(self, url: str, html_content: Optional[str] = None) -> Optional[LabInfo]:
        """
        Main parsing method - returns structured lab information
        """
        if not self.is_portswigger_url(url):
            return None
        
        lab_id = self.extract_lab_id(url)
        if not lab_id:
            # Try to extract from full URL as fallback
            lab_id = 'unknown'
        
        lab_type = self.detect_lab_type(url, html_content)
        difficulty = self.get_lab_difficulty(url)
        
        # Get category from detected type
        category = 'Unknown'
        if lab_type in self.compiled_patterns:
            category = self.compiled_patterns[lab_type]['category']
        
        return LabInfo(
            lab_id=lab_id,
            lab_type=lab_type,
            category=category,
            difficulty=difficulty,
            base_url=url,
            is_portswigger=True,
            raw_url=url
        )
    
